# All settings use the CERTMASTERY_ prefix so that machine-wide variables such as a
# global DATABASE_URL cannot silently redirect this application at another database.

# SQLite for local dev; PostgreSQL in production.
CERTMASTERY_DATABASE_URL=sqlite:///./certmastery.db
# CERTMASTERY_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/certmastery

# Session 2. Unset is fine: the platform falls back to each question's
# static_explanation, so every answer is still explained without it.
CERTMASTERY_ANTHROPIC_API_KEY=

CERTMASTERY_CLAUDE_MODEL=claude-opus-5
CERTMASTERY_CORS_ORIGINS=http://localhost:3000
